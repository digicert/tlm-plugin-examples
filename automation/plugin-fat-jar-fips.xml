<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
                              https://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <id>fat-jar</id>
  <formats>
    <format>jar</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>

  <dependencySets>
    <dependencySet>
      <outputDirectory>/</outputDirectory>
      <unpack>true</unpack>
      <useTransitiveDependencies>true</useTransitiveDependencies>
      <!-- FIPS variant: the BouncyCastle FIPS module must NOT be unpacked/repackaged
           or its integrity self-test fails ("Module checksum failed"). It is shipped
           intact under lib/ (see zip-fips.xml) and put on the classpath via the fat-jar
           manifest Class-Path, so the java -jar launch is unchanged. -->
      <excludes>
        <exclude>org.bouncycastle:*</exclude>
      </excludes>
      <unpackOptions>
        <excludes>
          <exclude>META-INF/versions/**</exclude>
          <exclude>module-info.class</exclude>
          <exclude>META-INF/*.SF</exclude>
          <exclude>META-INF/*.DSA</exclude>
          <exclude>META-INF/*.RSA</exclude>
        </excludes>
      </unpackOptions>
      <scope>runtime</scope>
    </dependencySet>
  </dependencySets>

  <fileSets>
    <fileSet>
      <directory>${project.build.outputDirectory}</directory>
      <outputDirectory>/</outputDirectory>
      <excludes>
        <exclude>module-info.class</exclude>
        <exclude>META-INF/versions/**</exclude>
      </excludes>
    </fileSet>
  </fileSets>
</assembly>
