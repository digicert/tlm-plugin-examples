<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>test-certdelivery-plugin</artifactId>
    <packaging>jar</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>test-certdelivery-plugin</name>
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- BouncyCastle coordinates default to the standard (non-FIPS) modules.
             The `fips` profile below swaps them for the FIPS-validated modules and
             fills fips.env.entries so plugin-meta.json advertises FIPS approved-only mode. -->
        <bc.prov.groupId>org.bouncycastle</bc.prov.groupId>
        <bc.prov.artifactId>bcprov-jdk18on</bc.prov.artifactId>
        <bc.prov.version>1.79</bc.prov.version>
        <bc.pkix.groupId>org.bouncycastle</bc.pkix.groupId>
        <bc.pkix.artifactId>bcpkix-jdk18on</bc.pkix.artifactId>
        <bc.pkix.version>1.79</bc.pkix.version>
        <fips.env.entries></fips.env.entries>

        <!-- Assembly descriptor selection + fat-jar manifest Class-Path. Defaults produce a
             single all-in-one fat-jar; the `fips` profile swaps to descriptors that keep the
             BouncyCastle FIPS module intact under lib/ and reference it here. -->
        <fatjar.descriptor>plugin-fat-jar.xml</fatjar.descriptor>
        <zip.descriptor>zip.xml</zip.descriptor>
        <plugin.classpath></plugin.classpath>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.digicert.tlm</groupId>
            <artifactId>plugin-sdk</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J Simple -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.9</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.9</version>
        </dependency>
        <dependency>
            <groupId>${bc.prov.groupId}</groupId>
            <artifactId>${bc.prov.artifactId}</artifactId>
            <version>${bc.prov.version}</version>
        </dependency>
        <dependency>
            <groupId>${bc.pkix.groupId}</groupId>
            <artifactId>${bc.pkix.artifactId}</artifactId>
            <version>${bc.pkix.version}</version>
        </dependency>
        <!-- Apache Commons Lang3 for Pair -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.14.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>com.google.code.maven-replacer-plugin</groupId>
                <artifactId>replacer</artifactId>
                <version>1.5.3</version>
                <executions>
                    <execution>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <file>${project.build.outputDirectory}/plugin-meta.json</file>
                    <replacements>
                        <replacement>
                            <token>\$\{project\.artifactId\}</token>
                            <value>${project.artifactId}</value>
                        </replacement>
                        <replacement>
                            <token>\$\{project\.version\}</token>
                            <value>${project.version}</value>
                        </replacement>
                        <replacement>
                            <token>"@TLM_FIPS_ENV@",</token>
                            <value>${fips.env.entries}</value>
                        </replacement>
                    </replacements>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>

                        <id>build-plugin-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>

                        <configuration>
                            <appendAssemblyId>false</appendAssemblyId>
                            <descriptors>
                                <descriptor>${project.basedir}/${fatjar.descriptor}</descriptor>
                            </descriptors>
                            <archive>
                                <manifest>
                                    <mainClass>
                                        com.example.certdelivery.MyCertDeliveryPluginRunner
                                    </mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>${plugin.classpath}</Class-Path>
                                </manifestEntries>
                            </archive>
                            <finalName>${project.artifactId}-${project.version}</finalName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>zip-all</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>${project.basedir}/${zip.descriptor}</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <ignoreMissingDescriptor>true</ignoreMissingDescriptor>
                            <outputDirectory>${project.basedir}/plugin-dist</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- FIPS stream: bundle the FIPS-validated BouncyCastle modules instead of the
             standard ones, and inject the FIPS runtime env into plugin-meta.json so the
             SDK CryptoPolicy runs the provider in approved-only mode. Build with `-Pfips`. -->
        <profile>
            <id>fips</id>
            <properties>
                <bc.prov.groupId>org.bouncycastle</bc.prov.groupId>
                <bc.prov.artifactId>bc-fips</bc.prov.artifactId>
                <bc.prov.version>2.1.3</bc.prov.version>
                <bc.pkix.groupId>org.bouncycastle</bc.pkix.groupId>
                <bc.pkix.artifactId>bcpkix-fips</bc.pkix.artifactId>
                <bc.pkix.version>2.1.12</bc.pkix.version>
                <fips.env.entries>"TLM_FIPS_APPROVED_ONLY=true","TLM_FIPS_CMVP_VERSION=${bc.prov.version}",</fips.env.entries>

                <bc.util.version>2.1.7</bc.util.version>
                <fatjar.descriptor>plugin-fat-jar-fips.xml</fatjar.descriptor>
                <zip.descriptor>zip-fips.xml</zip.descriptor>
                <plugin.classpath>lib/bc-fips-${bc.prov.version}.jar lib/bcpkix-fips-${bc.pkix.version}.jar lib/bcutil-fips-${bc.util.version}.jar</plugin.classpath>
            </properties>
            <dependencies>
                <!-- Pin the transitive bcutil-fips version so the fat-jar manifest Class-Path
                     filename above is deterministic. -->
                <dependency>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcutil-fips</artifactId>
                    <version>${bc.util.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
